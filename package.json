{
  "name": "book-my-show",
  "version": "1.0.0",
  "description": "High-scale BookMyShow backend architecture prototype using Fastify, TypeScript, and pnpm",
  "main": "dist/server.js",
  "type": "module",
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "oxlint .",
    "bench": "tsx scripts/run-bench.ts",
    "seed": "tsx scripts/seed-db.ts",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/swagger": "^8.14.0",
    "@fastify/swagger-ui": "^3.0.0",
    "@fastify/type-provider-typebox": "^4.0.0",
    "@sinclair/typebox": "^0.32.15",
    "dotenv": "^16.4.5",
    "fastify": "^4.26.2",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "oxlint": "^0.2.14",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
